# ---------------------------------------------------------------------------
# OniriFix · plantilla de entorno
# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y ajusta lo que necesites:
#   Copy-Item .env.template .env
#
# Ninguna de estas variables contiene secretos. Las rutas relativas se
# resuelven contra la raíz del proyecto (ONIRIFIX_HOME o el directorio actual).
# ---------------------------------------------------------------------------

# Directorio de trabajo. Si se omite, se usa el directorio actual.
# ONIRIFIX_HOME=.

# Base de datos SQLite del registro de obras, personajes, lugares y términos.
ONIRIFIX_DB=data/onirifix.db

# Configuración de reglas y umbrales.
ONIRIFIX_CONFIG=config/reglas.yaml

# Obra activa por defecto (slug del registro).
ONIRIFIX_OBRA=general

# Idioma de la obra. De momento el catálogo de reglas está pensado para español.
ONIRIFIX_IDIOMA=es

# Carpeta donde se escriben los informes.
ONIRIFIX_SALIDA=informes

# Carpeta de copias de seguridad antes de modificar un archivo.
ONIRIFIX_BACKUPS=.onirifix/backups

# Nivel de log: DEBUG, INFO, WARNING, ERROR.
ONIRIFIX_LOG_LEVEL=WARNING

# Umbral de confianza para aplicar hallazgos L2 (0.0 – 1.0).
ONIRIFIX_UMBRAL_L2=0.90

# Crear copia de seguridad antes de aplicar cambios (true/false).
ONIRIFIX_BACKUP=true

# Registrar los cambios aplicados en la tabla `correcciones` (true/false).
ONIRIFIX_AUDITORIA=true
